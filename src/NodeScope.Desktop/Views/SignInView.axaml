<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NodeScope.Desktop.ViewModels"
             x:Class="NodeScope.Desktop.Views.SignInView"
             x:DataType="vm:SignInViewModel">

  <StackPanel HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Width="400"
              Spacing="12">

    <TextBlock FontSize="28"
               FontWeight="SemiBold"
               HorizontalAlignment="Center"
               Text="NodeScope" />
    <TextBlock Name="TitleText"
               FontSize="14"
               Opacity="0.7"
               HorizontalAlignment="Center"
               Margin="0,0,0,12"
               Text="{Binding Title}" />

    <TextBox Name="ServerUrlBox"
             PlaceholderText="https://nodescope.example.com"
             Text="{Binding ServerUrl}"
             IsEnabled="{Binding !Busy}" />

    <TextBox Name="NameBox"
             PlaceholderText="Name"
             Text="{Binding Name}"
             IsVisible="{Binding CreatingAccount}"
             IsEnabled="{Binding !Busy}" />

    <TextBox Name="EmailBox"
             PlaceholderText="Email"
             Text="{Binding Email}"
             IsEnabled="{Binding !Busy}" />

    <TextBox Name="PasswordBox"
             PlaceholderText="Password"
             PasswordChar="•"
             Text="{Binding Password}"
             IsEnabled="{Binding !Busy}" />

    <Button Name="SubmitButton"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Center"
            Command="{Binding SubmitCommand}"
            IsDefault="True"
            IsEnabled="{Binding !Busy}"
            Content="{Binding SubmitLabel}" />

    <Button Name="RetryButton"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Center"
            Command="{Binding RetryCommand}"
            IsVisible="{Binding CanRetry}"
            Content="Retry connection" />

    <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Center"
                Spacing="8"
                IsVisible="{Binding Busy}">
      <ProgressBar IsIndeterminate="True" Width="120" />
      <TextBlock Name="ProgressText"
                 VerticalAlignment="Center"
                 Opacity="0.8"
                 Text="Signing in…" />
    </StackPanel>

    <TextBlock Name="ErrorText"
               Foreground="{DynamicResource SystemErrorTextColor}"
               TextWrapping="Wrap"
               IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}"
               Text="{Binding Error}" />

    <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Center"
                Spacing="6">
      <TextBlock Opacity="0.7"
                 VerticalAlignment="Center"
                 FontSize="13"
                 Text="{Binding SwitchPrompt}" />
      <Button Name="SwitchModeButton"
              Command="{Binding SwitchModeCommand}"
              Padding="2,0"
              Background="Transparent"
              FontSize="13"
              Foreground="{DynamicResource SystemAccentColor}"
              Content="{Binding SwitchLabel}" />
    </StackPanel>

  </StackPanel>

</UserControl>
