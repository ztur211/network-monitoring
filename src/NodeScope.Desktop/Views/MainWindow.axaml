<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NodeScope.Desktop.ViewModels"
        xmlns:views="using:NodeScope.Desktop.Views"
        x:Class="NodeScope.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="NodeScope"
        Width="1280"
        Height="800"
        WindowStartupLocation="CenterScreen">

  <Window.DataTemplates>
    <DataTemplate DataType="{x:Type vm:SignInViewModel}">
      <views:SignInView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:WorkspaceViewModel}">
      <views:WorkspaceView />
    </DataTemplate>
  </Window.DataTemplates>

  <DockPanel>

    <TextBlock Name="StatusText"
               DockPanel.Dock="Bottom"
               Margin="12,6"
               FontSize="12"
               Opacity="0.8"
               Text="{Binding Status}" />

    <ContentControl Content="{Binding Content}" />

  </DockPanel>

</Window>
