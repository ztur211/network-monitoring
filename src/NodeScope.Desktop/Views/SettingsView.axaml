<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NodeScope.Desktop.ViewModels"
             xmlns:api="using:NodeScope.Desktop.Api"
             x:Class="NodeScope.Desktop.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

  <UserControl.Styles>
    <Style Selector="Border.card">
      <Setter Property="Padding" Value="16" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
    </Style>
    <Style Selector="TextBlock.cardTitle">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="15" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="Opacity" Value="0.6" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="{DynamicResource SystemErrorTextColor}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="Consolas,Menlo,monospace" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer>
    <StackPanel Spacing="12" Margin="8,8,16,16" MaxWidth="640" HorizontalAlignment="Left">

      <TextBlock FontSize="20" FontWeight="SemiBold" Text="Settings" />

      <!-- ============================ Profile ============================ -->
      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Classes="cardTitle" Text="Account" />
          <StackPanel Spacing="4">
            <TextBlock Text="Name" FontWeight="Medium" />
            <TextBox Name="ProfileNameBox" Text="{Binding ProfileName}" />
          </StackPanel>
          <StackPanel Spacing="4">
            <TextBlock Text="Email" FontWeight="Medium" />
            <TextBox Name="ProfileEmailBox" Text="{Binding ProfileEmail}" />
          </StackPanel>
          <TextBlock Name="ProfileStatus"
                     Opacity="0.7"
                     IsVisible="{Binding ProfileStatus, Converter={x:Static ObjectConverters.IsNotNull}}"
                     Text="{Binding ProfileStatus}" />
          <TextBlock Name="ProfileError"
                     Classes="error"
                     IsVisible="{Binding ProfileError, Converter={x:Static ObjectConverters.IsNotNull}}"
                     Text="{Binding ProfileError}" />
          <Button Name="SaveProfileButton"
                  Classes="accent"
                  Command="{Binding SaveProfileCommand}"
                  IsEnabled="{Binding !SavingProfile}"
                  Content="Save profile" />
        </StackPanel>
      </Border>

      <!-- ========================= Organization ========================= -->
      <Border Classes="card" Name="OrganizationCard">
        <StackPanel Spacing="10">
          <DockPanel>
            <TextBlock DockPanel.Dock="Right"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Opacity="0.7"
                       Text="{Binding AccessRole}" />
            <StackPanel Spacing="2">
              <TextBlock Classes="cardTitle" Text="Organization" />
              <TextBlock Name="OrganizationName"
                         FontSize="18"
                         FontWeight="SemiBold"
                         Text="{Binding Organization.Name}" />
            </StackPanel>
          </DockPanel>

          <TextBlock FontWeight="Medium" Text="People" />
          <ItemsControl Name="OrganizationMemberList" ItemsSource="{Binding OrganizationMembers}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="api:OrganizationMember">
                <Border Margin="0,0,0,6"
                        Padding="10"
                        CornerRadius="8"
                        Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
                  <StackPanel Spacing="2">
                    <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                    <TextBlock Classes="hint" Text="{Binding DetailLine}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <StackPanel Name="OrganizationManagePanel"
                      Spacing="10"
                      IsVisible="{Binding CanManage}">
            <Border Height="1"
                    Margin="0,2"
                    Background="{DynamicResource SystemControlForegroundBaseLowBrush}" />

            <TextBlock FontWeight="Medium" Text="Invite someone" />
            <TextBlock Classes="hint"
                       Text="The code is shown once. Send it directly to the teammate, who pastes it into the native client after creating an account with the invited email." />
            <Grid ColumnDefinitions="*,8,140">
              <TextBox Grid.Column="0"
                       Name="InviteEmailBox"
                       PlaceholderText="teammate@example.com"
                       Text="{Binding InviteEmail}"
                       IsEnabled="{Binding !OrganizationBusy}" />
              <ComboBox Grid.Column="2"
                        Name="InviteRolePicker"
                        HorizontalAlignment="Stretch"
                        ItemsSource="{Binding InvitationRoles}"
                        SelectedItem="{Binding InviteRole}"
                        IsEnabled="{Binding !OrganizationBusy}" />
            </Grid>
            <Button Name="CreateInvitationButton"
                    Classes="accent"
                    Command="{Binding CreateInvitationCommand}"
                    IsEnabled="{Binding !OrganizationBusy}"
                    Content="Create invitation code" />

            <StackPanel Spacing="4"
                        IsVisible="{Binding InvitationCode, Converter={x:Static ObjectConverters.IsNotNull}}">
              <TextBlock FontWeight="Medium" Text="Invitation code" />
              <TextBox Name="InvitationCodeBox"
                       FontFamily="Consolas,Menlo,monospace"
                       FontSize="12"
                       IsReadOnly="True"
                       Text="{Binding InvitationCode}" />
              <TextBlock Classes="hint"
                         Text="Select the code and copy it. It is not stored in retrievable form after this response." />
            </StackPanel>

            <TextBlock FontWeight="Medium"
                       Margin="0,4,0,0"
                       Text="Pending invitations" />
            <ItemsControl Name="InvitationList" ItemsSource="{Binding Invitations}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="api:PendingInvitation">
                  <Border Margin="0,0,0,6"
                          Padding="10"
                          CornerRadius="8"
                          BorderThickness="1"
                          BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                    <DockPanel>
                      <Button DockPanel.Dock="Right"
                              VerticalAlignment="Center"
                              Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).RevokeInvitationCommand}"
                              CommandParameter="{Binding}"
                              IsEnabled="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).CanMutateOrganization}"
                              Content="Revoke" />
                      <StackPanel Spacing="2">
                        <TextBlock FontWeight="SemiBold" Text="{Binding Email}" />
                        <TextBlock Classes="hint" Text="{Binding DetailLine}" />
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock FontWeight="Medium"
                       Margin="0,4,0,0"
                       Text="Access requests" />
            <ItemsControl Name="JoinRequestList" ItemsSource="{Binding JoinRequests}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="api:OrganizationJoinRequest">
                  <Border Margin="0,0,0,6"
                          Padding="10"
                          CornerRadius="8"
                          BorderThickness="1"
                          BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                    <DockPanel>
                      <StackPanel DockPanel.Dock="Right"
                                  Orientation="Horizontal"
                                  VerticalAlignment="Center"
                                  Spacing="6">
                        <Button Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).DenyJoinRequestCommand}"
                                CommandParameter="{Binding}"
                                IsEnabled="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).CanMutateOrganization}"
                                Content="Deny" />
                        <Button Classes="accent"
                                Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).ApproveJoinRequestCommand}"
                                CommandParameter="{Binding}"
                                IsEnabled="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).CanMutateOrganization}"
                                Content="Approve" />
                      </StackPanel>
                      <StackPanel Spacing="2">
                        <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                        <TextBlock Classes="hint" Text="{Binding DetailLine}" />
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <ProgressBar Height="3"
                       IsIndeterminate="True"
                       IsVisible="{Binding OrganizationBusy}" />
          <TextBlock Name="OrganizationError"
                     Classes="error"
                     IsVisible="{Binding OrganizationError, Converter={x:Static ObjectConverters.IsNotNull}}"
                     Text="{Binding OrganizationError}" />
        </StackPanel>
      </Border>

      <!-- ========================= Home location ========================= -->
      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Classes="cardTitle" Text="Home location" />
          <TextBlock Classes="hint"
                     Text="Used as the map's starting point. The appliance geocodes the address; nothing leaves your network except the one lookup to OpenStreetMap." />
          <TextBox Name="AddressBox"
                   PlaceholderText="e.g. 260 Broadway, New York, NY"
                   Text="{Binding AddressText}" />
          <TextBlock Name="LocationResult"
                     Opacity="0.7"
                     IsVisible="{Binding LocationResult, Converter={x:Static ObjectConverters.IsNotNull}}"
                     Text="{Binding LocationResult}" />
          <TextBlock Name="LocationError"
                     Classes="error"
                     IsVisible="{Binding LocationError, Converter={x:Static ObjectConverters.IsNotNull}}"
                     Text="{Binding LocationError}" />
          <Button Name="SetLocationButton"
                  Command="{Binding SetLocationCommand}"
                  IsEnabled="{Binding !SettingLocation}"
                  Content="Set home location" />
        </StackPanel>
      </Border>

      <!-- ========================== Appearance =========================== -->
      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Classes="cardTitle" Text="Appearance" />
          <ComboBox Name="ThemePicker"
                    HorizontalAlignment="Stretch"
                    ItemsSource="{Binding Themes}"
                    SelectedItem="{Binding SelectedTheme}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ThemeOption">
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Classes="hint"
                     Text="Stored on this machine. The appliance has no say in how you like your pixels." />
        </StackPanel>
      </Border>

      <!-- ============================ Agents ============================= -->
      <Border Classes="card" Name="AgentsCard" IsVisible="{Binding CanManage}">
        <StackPanel Spacing="8">
          <TextBlock Classes="cardTitle" Text="Agents" />
          <TextBlock Classes="hint"
                     Text="Agents watch the network 24/7 from inside it. Generate a code, run the installer on the machine, and the agent appears here." />
          <Button Name="GenerateCodeButton"
                  Classes="accent"
                  Command="{Binding GenerateEnrollmentCodeCommand}"
                  Content="Generate enrollment code" />
          <StackPanel Spacing="4"
                      IsVisible="{Binding EnrollmentCode, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Name="EnrollmentCodeText" Classes="mono" Text="{Binding EnrollmentCode}" />
            <Border Padding="8" CornerRadius="6"
                    Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
              <StackPanel Spacing="6">
                <TextBlock Classes="mono" Text="{Binding InstallCommand}" />
                <TextBlock Classes="mono" Text="{Binding EnrollCommand}" />
              </StackPanel>
            </Border>
          </StackPanel>
          <TextBlock Name="AgentsError"
                     Classes="error"
                     IsVisible="{Binding AgentsError, Converter={x:Static ObjectConverters.IsNotNull}}"
                     Text="{Binding AgentsError}" />
          <ItemsControl Name="AgentList" ItemsSource="{Binding Agents}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:AgentRow">
                <Border Margin="0,0,0,6" Padding="10" CornerRadius="8" BorderThickness="1"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                  <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6"
                                VerticalAlignment="Center" IsVisible="{Binding CanRevoke}">
                      <Button Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).RevokeAgentCommand}"
                              CommandParameter="{Binding}"
                              IsVisible="{Binding !ConfirmingRevoke}"
                              Content="Revoke" />
                      <Button Classes="accent"
                              Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).RevokeAgentCommand}"
                              CommandParameter="{Binding}"
                              IsVisible="{Binding ConfirmingRevoke}"
                              Content="Confirm revoke?" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock FontWeight="SemiBold" Text="{Binding Agent.Name}" />
                        <TextBlock FontSize="12" Foreground="{Binding StatusColor}" Text="{Binding Agent.Status}" />
                      </StackPanel>
                      <TextBlock Classes="hint" Text="{Binding DetailLine}" />
                    </StackPanel>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- ============================= SNMP ============================== -->
      <Border Classes="card" Name="SnmpCard" IsVisible="{Binding CanManage}">
        <StackPanel Spacing="8">
          <TextBlock Classes="cardTitle" Text="SNMP" />
          <TextBlock Name="SnmpError"
                     Classes="error"
                     IsVisible="{Binding SnmpError, Converter={x:Static ObjectConverters.IsNotNull}}"
                     Text="{Binding SnmpError}" />

          <DockPanel>
            <Button DockPanel.Dock="Right"
                    Name="AddCredentialButton"
                    Command="{Binding ToggleCredentialFormCommand}"
                    Content="+ Credential" />
            <TextBlock FontWeight="Medium" VerticalAlignment="Center" Text="Credentials" />
          </DockPanel>

          <StackPanel Name="CredentialForm" Spacing="6" IsVisible="{Binding CredentialFormOpen}">
            <TextBox Name="CredentialNameBox" PlaceholderText="Credential name" Text="{Binding CredentialName}" />
            <CheckBox Name="CredentialV3Toggle" IsChecked="{Binding CredentialIsV3}" Content="SNMPv3 (v2c otherwise)" />
            <TextBox Name="CommunityBox"
                     PlaceholderText="Community string"
                     PasswordChar="•"
                     Text="{Binding CredentialCommunity}"
                     IsVisible="{Binding !CredentialIsV3}" />
            <StackPanel Spacing="6" IsVisible="{Binding CredentialIsV3}">
              <ComboBox HorizontalAlignment="Stretch"
                        ItemsSource="{x:Static vm:SettingsViewModel.SecurityLevels}"
                        SelectedItem="{Binding CredentialSecurityLevel}" />
              <TextBox PlaceholderText="Security name (user)" Text="{Binding CredentialSecurityName}" />
              <Grid ColumnDefinitions="*,8,*">
                <ComboBox Grid.Column="0" HorizontalAlignment="Stretch"
                          ItemsSource="{x:Static vm:SettingsViewModel.AuthProtocols}"
                          SelectedItem="{Binding CredentialAuthProtocol}" />
                <TextBox Grid.Column="2" PlaceholderText="Auth key" PasswordChar="•" Text="{Binding CredentialAuthKey}" />
              </Grid>
              <Grid ColumnDefinitions="*,8,*">
                <ComboBox Grid.Column="0" HorizontalAlignment="Stretch"
                          ItemsSource="{x:Static vm:SettingsViewModel.PrivProtocols}"
                          SelectedItem="{Binding CredentialPrivProtocol}" />
                <TextBox Grid.Column="2" PlaceholderText="Priv key" PasswordChar="•" Text="{Binding CredentialPrivKey}" />
              </Grid>
            </StackPanel>
            <Button Name="CreateCredentialButton"
                    Classes="accent"
                    Command="{Binding CreateCredentialCommand}"
                    Content="Create credential" />
          </StackPanel>

          <ItemsControl Name="CredentialList" ItemsSource="{Binding Credentials}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SnmpCredentialRow">
                <Border Margin="0,0,0,6" Padding="10" CornerRadius="8" BorderThickness="1"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                  <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6"
                                VerticalAlignment="Center">
                      <Button Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).DeleteCredentialCommand}"
                              CommandParameter="{Binding}"
                              IsVisible="{Binding !ConfirmingDelete}"
                              Content="Delete" />
                      <Button Classes="accent"
                              Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).DeleteCredentialCommand}"
                              CommandParameter="{Binding}"
                              IsVisible="{Binding ConfirmingDelete}"
                              Content="Confirm delete?" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                      <TextBlock FontWeight="SemiBold" Text="{Binding Credential.Name}" />
                      <TextBlock Classes="hint" Text="{Binding DetailLine}" />
                    </StackPanel>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <DockPanel Margin="0,8,0,0">
            <Button DockPanel.Dock="Right"
                    Name="AddProfileButton"
                    Command="{Binding ToggleProfileFormCommand}"
                    Content="+ Profile" />
            <TextBlock FontWeight="Medium" VerticalAlignment="Center" Text="OID profiles" />
          </DockPanel>

          <StackPanel Name="ProfileForm" Spacing="6" IsVisible="{Binding ProfileFormOpen}">
            <TextBox Name="ProfileNameFormBox" PlaceholderText="Profile name" Text="{Binding OidProfileName}" />
            <CheckBox IsChecked="{Binding OidProfileInterfaceMetrics}" Content="Include interface metrics" />
            <ItemsControl ItemsSource="{Binding OidEntries}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:OidEntryDraft">
                  <Grid ColumnDefinitions="*,8,*,8,Auto" Margin="0,0,0,6">
                    <TextBox Grid.Column="0" PlaceholderText="OID (1.3.6.1...)" Text="{Binding Oid}" />
                    <TextBox Grid.Column="2" PlaceholderText="Metric name" Text="{Binding Metric}" />
                    <Button Grid.Column="4"
                            Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).RemoveOidEntryCommand}"
                            CommandParameter="{Binding}"
                            Content="✕" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button Command="{Binding AddOidEntryCommand}" Content="+ OID" />
              <Button Name="CreateProfileButton"
                      Classes="accent"
                      Command="{Binding CreateOidProfileCommand}"
                      Content="Create profile" />
            </StackPanel>
          </StackPanel>

          <ItemsControl Name="ProfileList" ItemsSource="{Binding Profiles}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="api:OidProfileSummary">
                <Border Margin="0,0,0,6" Padding="10" CornerRadius="8" BorderThickness="1"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                  <StackPanel Spacing="2">
                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                    <TextBlock Classes="hint"
                               IsVisible="{Binding IncludeInterfaceMetrics}"
                               Text="Interface metrics included" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock FontWeight="Medium" Margin="0,8,0,0" Text="Assignment" />
          <TextBlock Classes="hint"
                     Text="Point a device or the network at a credential and profile. None clears the assignment; a device without its own falls back to the network's." />
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button Name="AssignDeviceToggle"
                    Classes.accent="{Binding AssignToDevice}"
                    Command="{Binding SelectAssignDeviceCommand}"
                    Content="Device" />
            <Button Name="AssignNetworkToggle"
                    Classes.accent="{Binding !AssignToDevice}"
                    Command="{Binding SelectAssignNetworkCommand}"
                    Content="Network" />
          </StackPanel>
          <ComboBox Name="AssignTargetPicker"
                    HorizontalAlignment="Stretch"
                    PlaceholderText="Target"
                    ItemsSource="{Binding AssignTargets}"
                    SelectedItem="{Binding AssignTarget}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:AssignOption">
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Grid ColumnDefinitions="*,8,*">
            <ComboBox Grid.Column="0" Name="AssignCredentialPicker"
                      HorizontalAlignment="Stretch"
                      ItemsSource="{Binding AssignCredentials}"
                      SelectedItem="{Binding AssignCredential}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:AssignOption">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <ComboBox Grid.Column="2" Name="AssignProfilePicker"
                      HorizontalAlignment="Stretch"
                      ItemsSource="{Binding AssignProfiles}"
                      SelectedItem="{Binding AssignProfile}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:AssignOption">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </Grid>
          <TextBlock Name="AssignResult"
                     Opacity="0.7"
                     IsVisible="{Binding AssignResult, Converter={x:Static ObjectConverters.IsNotNull}}"
                     Text="{Binding AssignResult}" />
          <Button Name="AssignButton"
                  Command="{Binding AssignCommand}"
                  Content="Apply assignment" />
        </StackPanel>
      </Border>

      <!-- ========================= Data sources ========================== -->
      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Classes="cardTitle" Text="Data sources" />
          <ItemsControl Name="DataSourceList" ItemsSource="{Binding DataSources}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="api:DataSource">
                <StackPanel Spacing="2" Margin="0,0,0,6">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock FontWeight="SemiBold" Text="{Binding Type}" />
                    <TextBlock FontSize="12"
                               Opacity="0.7"
                               Text="{Binding Connected, StringFormat='connected: {0}'}" />
                  </StackPanel>
                  <TextBlock Classes="hint" Text="{Binding Message}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>

</UserControl>
