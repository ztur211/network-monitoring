<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NodeScope.Desktop.ViewModels"
             xmlns:views="using:NodeScope.Desktop.Views"
             x:Class="NodeScope.Desktop.Views.WorkspaceView"
             x:DataType="vm:WorkspaceViewModel">

  <UserControl.DataTemplates>
    <DataTemplate DataType="{x:Type vm:MapViewModel}">
      <views:MapView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:BimViewerViewModel}">
      <views:BimViewerView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:InventoryViewModel}">
      <views:InventoryView />
    </DataTemplate>
  </UserControl.DataTemplates>

  <DockPanel>

    <Border DockPanel.Dock="Top" Padding="12,8">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right"
                    Orientation="Horizontal"
                    Spacing="12">
          <TextBlock Name="UserChip"
                     VerticalAlignment="Center"
                     Opacity="0.8"
                     Text="{Binding UserLabel}" />
          <Button Name="SignOutButton"
                  Command="{Binding SignOutCommand}"
                  Content="Sign out" />
        </StackPanel>
        <TextBlock VerticalAlignment="Center"
                   FontWeight="SemiBold"
                   Text="NodeScope" />
      </DockPanel>
    </Border>

    <ListBox Name="NavRail"
             DockPanel.Dock="Left"
             Width="180"
             Margin="8,0,0,8"
             ItemsSource="{Binding Sections}"
             SelectedItem="{Binding SelectedSection}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:WorkspaceSection">
          <TextBlock Text="{Binding Title}" />
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <Panel>

      <!-- Shipped surfaces render their view model through the DataTemplates above… -->
      <ContentControl Content="{Binding SelectedSection.Content}"
                      IsVisible="{Binding SelectedSection.Content, Converter={x:Static ObjectConverters.IsNotNull}}" />

      <!-- …surfaces still to come keep the placeholder. -->
      <StackPanel HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="8"
                  IsVisible="{Binding SelectedSection.Content, Converter={x:Static ObjectConverters.IsNull}}">
        <TextBlock Name="SectionTitle"
                   HorizontalAlignment="Center"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Text="{Binding SelectedSection.Title}" />
        <TextBlock HorizontalAlignment="Center"
                   Opacity="0.7"
                   TextWrapping="Wrap"
                   MaxWidth="420"
                   TextAlignment="Center"
                   Text="{Binding SelectedSection.Placeholder}" />
      </StackPanel>

    </Panel>

  </DockPanel>

</UserControl>
