<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The native desktop client (sequencing step 5, Decision 14: Avalonia 12).
    Replaces apps/web (Expo/RN-Web) and apps/desktop (Electron + three.js) with
    one client. References Contracts only - the client talks to the appliance
    over HTTP and SignalR, never to server internals; DesktopBoundaryRules in
    the architecture tests enforces it, exactly as for the agent.

    Run under WSLg with: dotnet run (project src/NodeScope.Desktop)
    Decision 16's xBIM tessellation stays behind a Windows-only seam. Its
    portable wexBIM reader and GL/software viewers run on every supported OS.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Version>0.1.0</Version>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Silk's span-friendly GL upload overloads still cross an unmanaged pointer boundary. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <!-- Bundled UI font: identical text rendering on every OS instead of host-font fallback. -->
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <!-- Decision 15: the map view. Natives pinned for Linux - see Directory.Packages.props. -->
    <PackageReference Include="Mapsui.Avalonia12" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" />
    <PackageReference Include="Silk.NET.OpenGL" />
    <!-- Decision 16: IFC tessellation runs only on Windows; viewing the derived wexBIM stays portable. -->
    <PackageReference Include="Xbim.Essentials" />
    <PackageReference Include="Xbim.Geometry" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <!-- The realtime wire: assistant chat now, live entity updates with the realtime milestone. -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    <!-- Decision 17: the Windows token vault wraps the entry with per-user DPAPI. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../NodeScope.Contracts/NodeScope.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NodeScope.Desktop.Tests" />
  </ItemGroup>

</Project>
