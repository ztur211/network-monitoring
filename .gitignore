# Environment
.env
.env.*
!.env.example
# The demo env holds only localhost throwaway values (see its header) and is
# committed on purpose so the 3D demo is turnkey.
!deploy/.env.demo

# Local-only docs and AI config
CLAUDE.md
docs/*
# …except product-knowledge: the AI loads it at runtime (docs/product-knowledge),
# so it must ship in the repo + image, not stay local-only.
!docs/product-knowledge/
# …and design docs: versioned architecture/decision records belong in the repo.
!docs/design/
.claude/
PROGRESS.md

# Local runtime artifacts (e.g. a Redis server started in-repo drops its dump here)
*.rdb

# Dependencies
node_modules/

# Build output
dist/
build/
.expo/
web-build/

# TypeScript
*.tsbuildinfo

# Prisma
apps/api/prisma/migrations/*.sql.bak

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
# NOTE: `*.sln` used to be ignored here (inherited from the stock Node
# .gitignore template, back when nothing in this repo was .NET). The C# solution
# lives at NodeScope.slnx and must be committed, so that entry is gone.

# .NET
bin/
obj/
*.user
.vs/
artifacts/
# NuGet package restore output; packages themselves are restored from
# Directory.Packages.props, never vendored.
*.nupkg

# Local-only demo recordings (kept on disk, not committed)
demo/

# run-desktop.sh runtime logs + pid files
.run/
