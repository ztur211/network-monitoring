# Build-context hygiene for deploy/Dockerfile.* (build context = repo root).
# Excludes anything the images rebuild or must never contain.

# Build outputs - rebuilt inside the image
**/bin
**/obj
artifacts

# VCS / CI / logs
.git
.github
*.log

# Secrets & local env - never bake into an image
.env
.env.*
deploy/.env

# Local-only docs
docs
