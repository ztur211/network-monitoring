# Database
DATABASE_URL=postgresql://nodescope:localdevpassword@localhost:5432/nodescope_dev
TEST_DATABASE_URL=postgresql://nodescope:localdevpassword@localhost:5433/nodescope_test

# Redis (OPTIONAL). Leave unset to run SINGLE-NODE with an in-memory backing — the API is
# fully functional on one process without Redis. Set it to share HTTP rate limits, realtime
# rooms/locks and caches across replicas.
REDIS_URL=redis://localhost:6379
# CLUSTER_MODE: set true only when running MULTIPLE API replicas behind a load balancer.
# It makes REDIS_URL mandatory (fail-closed) — the app refuses to boot clustered without a
# shared Redis, so replicas never silently diverge. Leave false/unset for single-node.
CLUSTER_MODE=false

# Auth — BETTER_AUTH_SECRET minimum 32 characters
BETTER_AUTH_SECRET=local-dev-secret-minimum-32-characters-long
BETTER_AUTH_URL=http://localhost:3000
FRONTEND_URL=http://localhost:8081

# AI — LOCAL MODELS ONLY. Hosted providers were removed deliberately: the AI
# context carries device IPs, topology, notes and circuit IDs, which must never
# leave the building (docs/design/2026-07-19-systems-architecture-and-data-flows.md).
# Point AI_BASE_URL at any OpenAI-compatible runtime — Ollama, llama.cpp, vLLM,
# LM Studio. Leave it unreachable and the assistant degrades to its canned
# network-aware fallback rather than failing.
AI_BASE_URL=http://localhost:11434/v1
AI_API_KEY=ollama
AI_MODEL=llama3
AI_TIMEOUT_MS=60000

# Map (backend, for Nominatim User-Agent)
GEOCODING_USER_AGENT=NodeScope/1.0 (dev@nodescope.io)

# Web (read by apps/web at build/run time — must be exported in the shell or set
# at expo build time, NOT just placed in this .env which is api-side)
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_MAP_TILE_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# App
NODE_ENV=development
PORT=3000

# Object storage
# Storage driver: s3 (default; S3/MinIO) or fs (local filesystem, single-node appliance).
STORAGE_DRIVER=s3
# Filesystem storage root (used only when STORAGE_DRIVER=fs).
STORAGE_FS_ROOT=./var/storage
# S3-compatible settings (MinIO in dev/test; used when STORAGE_DRIVER=s3)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=nodescope
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
MODEL_MAX_BYTES=209715200

# Seed
SEED_PASSWORD=devpassword123

# SNMP credential encryption key — 32 bytes, base64-encoded.
# MUST be unique per environment. NEVER copy this placeholder into production.
# Generate a fresh key: openssl rand -base64 32
SECRET_ENCRYPTION_KEY=CHANGE_ME-generate-with-openssl-rand-base64-32

# Embedded device prober (Spec 7; self-host / on-network only — cloud uses the Agent)
MONITORING_PROBER_ENABLED=false
MONITORING_PROBE_INTERVAL_MS=30000
MONITORING_PROBE_CONCURRENCY=20
MONITORING_ICMP_ENABLED=true
MONITORING_PROBE_PORTS=443,80,22
MONITORING_PROBE_TIMEOUT_MS=2000
MONITORING_DOWN_THRESHOLD=3
MONITORING_WARN_LATENCY_MS=250
