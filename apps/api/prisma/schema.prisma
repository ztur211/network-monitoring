generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum AccountTier {
  PERSONAL_FREE
  PERSONAL_PAID
  MULTI_PROPERTY
  ENTERPRISE
}

enum DeviceCategory {
  // ISP Equipment - minZoom 10
  RAD
  ONT
  DSLAM

  // Core Infrastructure - minZoom 13
  ROUTER
  MODEM
  FIBER_MEDIA_CONVERTER
  FIREWALL

  // Network Equipment - minZoom 16
  SWITCH
  ACCESS_POINT
  WIFI_EXTENDER
  WIRELESS_BRIDGE
  SERVER_RACK
  PATCH_PANEL
  UPS

  // End-User Devices - minZoom 18
  COMPUTER
  PHONE
  TABLET
  PRINTER
  IOT_DEVICE

  // Other - minZoom 16
  CUSTOM
}

enum DeviceMobility {
  HOME_ONLY
  ROAMS
  UNKNOWN
}

enum DeviceStatusState {
  UP
  DOWN
  WARNING
  UNKNOWN
}

enum ConnectionType {
  ETHERNET
  FIBER
  WIFI
  LOGICAL
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  DENIED
}

enum PropertyType {
  SITE
  BUILDING
  FLOOR
  AREA
}

enum ChangeAction {
  CREATE
  UPDATE
  DELETE
}

enum AgentStatus {
  PENDING
  APPROVED
  REVOKED
}

enum SnmpVersion {
  V2C
  V3
}

enum SnmpSecurityLevel {
  NO_AUTH_NO_PRIV
  AUTH_NO_PRIV
  AUTH_PRIV
}

enum SnmpAuthProtocol {
  MD5
  SHA
  SHA256
}

enum SnmpPrivProtocol {
  DES
  AES
  AES256
}

enum AlertChannelType {
  WEBHOOK
  EMAIL
  INAPP
}

enum AlertTrigger {
  STATE_TRANSITION
  METRIC_THRESHOLD
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AlertEventKind {
  FIRING
  RESOLVED
}

enum AlertDeliveryStatus {
  PENDING
  SENT
  FAILED
  GAVE_UP
}

// ─── Better Auth Models ───────────────────────────────────────────────────────

model User {
  id            String  @id @default(uuid())
  email         String  @unique
  emailVerified Boolean @default(false)
  name          String?
  image         String?

  tier                  AccountTier @default(PERSONAL_FREE)
  isSuperAdmin          Boolean     @default(false)
  homeLatitude          Float?
  homeLongitude         Float?
  mapPreferences        Json        @default("{}")
  // Set once the first-run onboarding wizard completes. Durable source of truth
  // for "has this user finished onboarding?" — survives a full Redis flush (the
  // short-lived Redis wizard state cannot be relied on for this).
  onboardingCompletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts    Account[]
  sessions    Session[]
  devices     Device[]
  circuits    Circuit[]
  fiberRuns   FiberRun[]
  connections DeviceConnection[]
  changeLogs  ChangeLog[]
  networks    Network[]

  orgMember    OrganizationMember?
  joinRequests JoinRequest[]
}

model Account {
  id                    String    @id @default(uuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([identifier])
}

// ─── Device & Network Models ──────────────────────────────────────────────────

model Device {
  id             String                                @id @default(uuid())
  organizationId String
  userId         String?
  networkId      String
  propertyId     String
  roleCode       String?
  name           String
  category       DeviceCategory
  mobility       DeviceMobility                        @default(UNKNOWN)
  latitude       Float?
  longitude      Float?
  location       Unsupported("geometry(Point, 4326)")?
  floor          Int?
  floorLabel     String?
  x              Float? // model-local 3D coords (m) in the device's BUILDING active model — Spec 1
  y              Float?
  z              Float?
  // Native IFC GlobalId (GUID) of the BIM element this device is linked to, if any. This is the
  // ONLY join key between network data and the BIM model: the IFC export carries the element's
  // native GlobalId but no network data, so clicking the BIM object resolves to this device's live
  // info without the model ever embedding IP/MAC/metrics. Independent of x/y/z placement.
  ifcGlobalId    String?
  ipAddress      String?
  macAddress     String?
  notes          String?
  version        Int                                   @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  network      Network      @relation(fields: [networkId], references: [id], onDelete: Restrict)
  property     Property     @relation(fields: [propertyId], references: [id], onDelete: Restrict)

  snmpCredentialId String?
  oidProfileId     String?

  connectionsFrom DeviceConnection[] @relation("sourceDevice")
  connectionsTo   DeviceConnection[] @relation("targetDevice")
  fiberRunsFrom   FiberRun[]         @relation("startDevice")
  fiberRunsTo     FiberRun[]         @relation("endDevice")
  circuits        Circuit[]
  status          DeviceStatus?
  snmpCredential  SnmpCredential?    @relation(fields: [snmpCredentialId], references: [id], onDelete: Restrict)
  oidProfile      OidProfile?        @relation(fields: [oidProfileId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([organizationId, category])
  @@index([organizationId, floor])
  @@index([organizationId, networkId])
  @@index([organizationId, propertyId])
  // Serves the device-list query: WHERE organizationId ORDER BY createdAt DESC
  // (index provides the sort order, eliminating the in-memory sort).
  @@index([organizationId, createdAt])
  // Resolves a clicked BIM element's GlobalId → linked device (org-scoped reverse lookup).
  @@index([organizationId, ifcGlobalId])
}

model Network {
  id             String  @id @default(uuid())
  organizationId String
  userId         String?
  name           String
  homeAddress    String?
  homeLatitude   Float?
  homeLongitude  Float?
  homePublicIp   String?
  isp            String?
  downMbps       Float?
  upMbps         Float?
  version        Int     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  snmpCredentialId String?
  oidProfileId     String?

  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  devices        Device[]
  networkLinks   NetworkProperty[]
  snmpCredential SnmpCredential?   @relation(fields: [snmpCredentialId], references: [id], onDelete: Restrict)
  oidProfile     OidProfile?       @relation(fields: [oidProfileId], references: [id], onDelete: Restrict)

  @@index([organizationId])
}

model DeviceConnection {
  id             String         @id @default(uuid())
  organizationId String
  userId         String?
  sourceDeviceId String
  targetDeviceId String
  connectionType ConnectionType
  notes          String?
  version        Int            @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  sourceDevice Device       @relation("sourceDevice", fields: [sourceDeviceId], references: [id], onDelete: Cascade)
  targetDevice Device       @relation("targetDevice", fields: [targetDeviceId], references: [id], onDelete: Cascade)

  @@unique([organizationId, sourceDeviceId, targetDeviceId, connectionType])
  @@index([organizationId, sourceDeviceId])
  @@index([organizationId, targetDeviceId])
}

model FiberRun {
  id             String  @id @default(uuid())
  organizationId String
  userId         String?
  name           String
  startDeviceId  String
  endDeviceId    String
  cableType      String?
  lengthMeters   Float?
  notes          String?
  version        Int     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  startDevice  Device       @relation("startDevice", fields: [startDeviceId], references: [id], onDelete: Cascade)
  endDevice    Device       @relation("endDevice", fields: [endDeviceId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, startDeviceId])
  @@index([organizationId, endDeviceId])
}

model Circuit {
  id             String  @id @default(uuid())
  organizationId String
  userId         String?
  ispName        String
  circuitId      String?
  serviceType    String
  bandwidth      Float?
  deviceId       String?
  notes          String?
  version        Int     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  device       Device?      @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([organizationId, deviceId])
}

// ─── Metrics & Audit Models ───────────────────────────────────────────────────

model DeviceMetric {
  id                String   @default(uuid())
  organizationId    String
  userId            String
  deviceId          String?
  sourceType        String
  tag               String?
  bandwidthDown     Float?
  bandwidthUp       Float?
  latency           Float?
  connectionQuality String?
  time              DateTime @default(now())

  // No @updatedAt — metrics are immutable once written
  // No version column — metrics are append-only
  // No User/Device relation — avoids Prisma overhead on hypertable. deviceId
  // is a plain nullable column; foreign-key cascade is handled in app layer.
  // organizationId is a plain column (no FK relation) — same reason as above.
  // tag is 'ambient' (default) or 'speedtest' (on-demand). Null treated as 'ambient'.
  // Composite PK: TimescaleDB requires the partitioning column (time) to be
  // part of every unique constraint on a hypertable.

  @@id([id, time])
  @@index([organizationId, time(sort: Desc)])
  @@index([organizationId, sourceType, time(sort: Desc)])
  @@index([organizationId, deviceId, time(sort: Desc)])
}

model ChangeLog {
  id             String       @id @default(uuid())
  organizationId String
  userId         String?
  requestId      String
  action         ChangeAction
  entityType     String
  entityId       String
  field          String?
  oldValue       String?
  newValue       String?
  snapshot       Json?
  ipAddress      String?
  userAgent      String?
  comment        String?
  createdAt      DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, entityType, entityId])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([requestId])
}

// ─── Organization Tenancy Models (F1a Phase A) ───────────────────────────────

model Organization {
  id             String   @id @default(uuid())
  name           String
  namingPattern  String?
  namingMaxLen   Int?     @default(63)
  namingTemplate String?
  version        Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  members               OrganizationMember[]
  domains               OrganizationDomain[]
  changeLogs            ChangeLog[]
  devices               Device[]
  networks              Network[]
  connections           DeviceConnection[]
  fiberRuns             FiberRun[]
  circuits              Circuit[]
  invitations           Invitation[]
  joinRequests          JoinRequest[]
  properties            Property[]
  networkProperties     NetworkProperty[]
  teams                 Team[]
  teamMembers           TeamMember[]
  teamProperties        TeamProperty[]
  memberProperties      MemberProperty[]
  buildingModels        BuildingModel[]
  buildingModelVersions BuildingModelVersion[]
  deviceStatuses        DeviceStatus[]
  monitoringIngestToken MonitoringIngestToken?
  agents                Agent[]
  agentEnrollmentCodes  AgentEnrollmentCode[]
  snmpCredentials       SnmpCredential[]
  oidProfiles           OidProfile[]
  bcfTopics             BcfTopic[]
  alertChannels         AlertChannel[]
  alertRules            AlertRule[]
}

model DeviceStatus {
  id               String            @id @default(uuid())
  organizationId   String
  deviceId         String            @unique
  state            DeviceStatusState @default(UNKNOWN)
  latencyMs        Float?
  consecutiveFails Int               @default(0)
  lastCheckAt      DateTime?
  lastOkAt         DateTime?
  lastChangeAt     DateTime?
  source           String?
  updatedAt        DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  device       Device       @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model MonitoringIngestToken {
  id             String   @id @default(uuid())
  organizationId String   @unique
  tokenHash      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model OrganizationDomain {
  id             String   @id @default(uuid())
  organizationId String
  domain         String   @unique
  verified       Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model OrganizationMember {
  id             String   @id @default(uuid())
  userId         String   @unique
  organizationId String
  role           OrgRole  @default(MEMBER)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  teamMemberships TeamMember[]
  siteAssignments MemberProperty[]
  createdTeams    Team[]           @relation("TeamCreator")

  @@index([organizationId])
}

model Invitation {
  id              String    @id @default(uuid())
  organizationId  String
  email           String
  role            OrgRole   @default(MEMBER)
  token           String    @unique
  expiresAt       DateTime
  invitedByUserId String?
  acceptedAt      DateTime?
  createdAt       DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
}

model JoinRequest {
  id              String            @id @default(uuid())
  organizationId  String
  userId          String
  status          JoinRequestStatus @default(PENDING)
  decidedByUserId String?
  decidedAt       DateTime?
  createdAt       DateTime          @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([userId])
}

// ─── Site Tree Models (F2) ────────────────────────────────────────────────────

model Property {
  id             String       @id @default(uuid())
  organizationId String
  parentId       String?
  type           PropertyType
  name           String
  code           String?
  version        Int          @default(1)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent            Property?         @relation("PropertyTree", fields: [parentId], references: [id], onDelete: Restrict)
  children          Property[]        @relation("PropertyTree")
  devices           Device[]
  networkLinks      NetworkProperty[]
  teamAssignments   TeamProperty[]    @relation("TeamPropertyAssignment")
  memberAssignments MemberProperty[]  @relation("MemberPropertyAssignment")
  buildingModel     BuildingModel?

  @@index([organizationId])
  @@index([organizationId, parentId])
  @@index([organizationId, type])
}

// ─── Network Charter Models (F2 Phase B) ─────────────────────────────────────

model NetworkProperty {
  id             String   @id @default(uuid())
  organizationId String
  networkId      String
  propertyId     String
  createdAt      DateTime @default(now())

  network      Network      @relation(fields: [networkId], references: [id], onDelete: Cascade)
  property     Property     @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([networkId, propertyId])
  @@index([organizationId])
  @@index([propertyId])
}

// ─── Team & Permission Models (F3) ───────────────────────────────────────────

model Team {
  id              String   @id @default(uuid())
  organizationId  String
  name            String
  creatorMemberId String? // OrganizationMember (owner or admin) who created it; null ⇒ owner-managed only
  version         Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator      OrganizationMember? @relation("TeamCreator", fields: [creatorMemberId], references: [id], onDelete: SetNull)
  members      TeamMember[]
  properties   TeamProperty[]

  @@index([organizationId])
  @@index([creatorMemberId])
}

model TeamMember {
  id             String   @id @default(uuid())
  organizationId String
  teamId         String
  memberId       String
  createdAt      DateTime @default(now())

  team         Team               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  member       OrganizationMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([teamId, memberId])
  @@index([organizationId])
  @@index([memberId])
}

model TeamProperty {
  id             String   @id @default(uuid())
  organizationId String
  teamId         String
  propertyId     String
  createdAt      DateTime @default(now())

  team         Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  property     Property     @relation("TeamPropertyAssignment", fields: [propertyId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([teamId, propertyId])
  @@index([organizationId])
  @@index([propertyId])
}

model MemberProperty {
  id             String   @id @default(uuid())
  organizationId String
  memberId       String
  propertyId     String
  createdAt      DateTime @default(now())

  member       OrganizationMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  property     Property           @relation("MemberPropertyAssignment", fields: [propertyId], references: [id], onDelete: Restrict)
  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([memberId, propertyId])
  @@index([organizationId])
  @@index([propertyId])
}

// ─── Spatial / Building Model Models (Spec 1) ────────────────────────────────

model BuildingModel {
  id              String   @id @default(uuid())
  organizationId  String
  propertyId      String   @unique // one model per BUILDING (propertyId is globally unique)
  name            String
  activeVersionId String?  @unique // 1:1 — a version is the active one of at most one model
  version         Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization  Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property      Property               @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  activeVersion BuildingModelVersion?  @relation("ActiveVersion", fields: [activeVersionId], references: [id], onDelete: SetNull)
  versions      BuildingModelVersion[] @relation("ModelVersions")

  @@index([organizationId])
}

model BuildingModelVersion {
  id                 String   @id @default(uuid())
  organizationId     String
  buildingModelId    String
  versionNumber      Int
  storageKey         String
  fileName           String
  contentHash        String
  sizeBytes          Int
  units              String?
  uploadedByMemberId String?
  createdAt          DateTime @default(now())

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  buildingModel  BuildingModel  @relation("ModelVersions", fields: [buildingModelId], references: [id], onDelete: Cascade)
  activeForModel BuildingModel? @relation("ActiveVersion")

  @@unique([buildingModelId, versionNumber])
  @@index([organizationId])
  @@index([buildingModelId])
}

// ─── Agent Registry Models (Spec 8) ──────────────────────────────────────────

model Agent {
  id                String      @id @default(uuid())
  organizationId    String
  name              String
  platform          String?
  version           String?
  status            AgentStatus @default(APPROVED)
  lastSeenAt        DateTime?
  tokenHash         String      @unique
  createdByMemberId String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model AgentEnrollmentCode {
  id                String   @id @default(uuid())
  organizationId    String
  codeHash          String   @unique
  expiresAt         DateTime
  createdByMemberId String?
  usedAt            DateTime?
  createdAt         DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// ─── SNMP Credential / OID Profile Models (Spec 9) ───────────────────────────

model SnmpCredential {
  id             String             @id @default(uuid())
  organizationId String
  name           String
  snmpVersion    SnmpVersion
  securityLevel  SnmpSecurityLevel?
  securityName   String?
  authProtocol   SnmpAuthProtocol?
  privProtocol   SnmpPrivProtocol?
  communityEnc   String?
  authKeyEnc     String?
  privKeyEnc     String?
  version        Int                @default(1)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  networks     Network[]
  devices      Device[]

  @@index([organizationId])
}

model AlertChannel {
  id             String           @id @default(uuid())
  organizationId String
  type           AlertChannelType
  name           String
  enabled        Boolean          @default(true)
  config         Json             @default("{}")
  secretEnc      String?
  version        Int              @default(1)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model AlertRule {
  id               String        @id @default(uuid())
  organizationId   String
  name             String
  enabled          Boolean       @default(true)
  trigger          AlertTrigger
  scope            Json          @default("{\"all\":true}")
  targetStates     String[]      @default([])
  metric           String?
  op               String?
  threshold        Float?
  forSeconds       Int?
  severity         AlertSeverity @default(WARNING)
  channelIds       String[]      @default([])
  cooldownSeconds  Int           @default(300)
  notifyOnRecovery Boolean       @default(true)
  version          Int           @default(1)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  events       AlertEvent[]

  @@index([organizationId])
  @@index([trigger, enabled])
}

model AlertEvent {
  id             String         @id @default(uuid())
  organizationId String
  ruleId         String
  deviceId       String?
  kind           AlertEventKind
  severity       AlertSeverity
  detail         Json           @default("{}")
  dedupKey       String
  createdAt      DateTime       @default(now())

  rule       AlertRule       @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  deliveries AlertDelivery[]

  @@index([organizationId, createdAt])
  @@index([dedupKey, createdAt])
}

model AlertDelivery {
  id            String              @id @default(uuid())
  alertEventId  String
  channelId     String
  status        AlertDeliveryStatus @default(PENDING)
  attempts      Int                 @default(0)
  lastAttemptAt DateTime?
  nextAttemptAt DateTime            @default(now())
  lastError     String?
  createdAt     DateTime            @default(now())

  event AlertEvent @relation(fields: [alertEventId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
}

model OidProfile {
  id                      String   @id @default(uuid())
  organizationId          String
  name                    String
  includeInterfaceMetrics Boolean  @default(false)
  version                 Int      @default(1)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entries      OidEntry[]
  networks     Network[]
  devices      Device[]

  @@index([organizationId])
}

model OidEntry {
  id           String @id @default(uuid())
  oidProfileId String
  oid          String
  metric       String

  profile OidProfile @relation(fields: [oidProfileId], references: [id], onDelete: Cascade)

  @@unique([oidProfileId, oid])
}

// ─── BCF (BIM Collaboration Format) Models (Spec 6) ─────────────────────────

model BcfTopic {
  id             String    @id @default(uuid())
  organizationId String
  propertyId     String
  guid           String
  title          String
  topicType      String?
  topicStatus    String?
  priority       String?
  labels         String[]  @default([])
  creationAuthor String
  creationDate   DateTime
  modifiedAuthor String?
  modifiedDate   DateTime?
  assignedTo     String?
  dueDate        DateTime?
  description    String?
  version        Int       @default(1)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  comments     BcfComment[]
  viewpoints   BcfViewpoint[]
  devices      BcfTopicDevice[]

  @@unique([organizationId, guid])
  @@index([organizationId, propertyId])
}

model BcfComment {
  id             String   @id @default(uuid())
  organizationId String
  topicId        String
  guid           String
  comment        String
  author         String
  date           DateTime
  viewpointGuid  String?

  topic BcfTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId])
}

model BcfViewpoint {
  id              String   @id @default(uuid())
  organizationId  String
  topicId         String
  guid            String
  camera          Json
  components      Json
  clippingPlanes  Json
  snapshotKey     String?
  isPrimary       Boolean  @default(false)

  topic BcfTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId])
}

model BcfTopicDevice {
  id      String @id @default(uuid())
  topicId String
  deviceId String

  topic BcfTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([topicId, deviceId])
  @@index([deviceId])
}

