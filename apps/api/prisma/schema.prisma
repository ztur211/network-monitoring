generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum AccountTier {
  PERSONAL_FREE
  PERSONAL_PAID
  MULTI_PROPERTY
  ENTERPRISE
}

enum DeviceCategory {
  // ISP Equipment - minZoom 10
  RAD
  ONT
  DSLAM

  // Core Infrastructure - minZoom 13
  ROUTER
  MODEM
  FIBER_MEDIA_CONVERTER
  FIREWALL

  // Network Equipment - minZoom 16
  SWITCH
  ACCESS_POINT
  WIFI_EXTENDER
  WIRELESS_BRIDGE
  SERVER_RACK
  PATCH_PANEL
  UPS

  // End-User Devices - minZoom 18
  COMPUTER
  PHONE
  TABLET
  PRINTER
  IOT_DEVICE

  // Other - minZoom 16
  CUSTOM
}

enum DeviceMobility {
  HOME_ONLY
  ROAMS
  UNKNOWN
}

enum ConnectionType {
  ETHERNET
  FIBER
  WIFI
  LOGICAL
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  DENIED
}

enum PropertyType {
  SITE
  BUILDING
  FLOOR
  AREA
}

enum ChangeAction {
  CREATE
  UPDATE
  DELETE
}

// ─── Better Auth Models ───────────────────────────────────────────────────────

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  emailVerified Boolean  @default(false)
  name          String?
  image         String?

  tier          AccountTier @default(PERSONAL_FREE)
  isSuperAdmin  Boolean     @default(false)
  homeLatitude  Float?
  homeLongitude Float?
  mapPreferences Json    @default("{}")
  // Set once the first-run onboarding wizard completes. Durable source of truth
  // for "has this user finished onboarding?" — survives a full Redis flush (the
  // short-lived Redis wizard state cannot be relied on for this).
  onboardingCompletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts   Account[]
  sessions   Session[]
  devices    Device[]
  circuits   Circuit[]
  fiberRuns  FiberRun[]
  connections DeviceConnection[]
  changeLogs ChangeLog[]
  networks   Network[]

  orgMember    OrganizationMember?
  joinRequests JoinRequest[]
}

model Account {
  id                    String    @id @default(uuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([identifier])
}

// ─── Device & Network Models ──────────────────────────────────────────────────

model Device {
  id             String         @id @default(uuid())
  organizationId String
  userId         String?
  networkId      String
  propertyId     String
  roleCode       String?
  name           String
  category       DeviceCategory
  mobility       DeviceMobility @default(UNKNOWN)
  latitude       Float?
  longitude      Float?
  location       Unsupported("geometry(Point, 4326)")?
  floor          Int?
  floorLabel     String?
  ipAddress      String?
  macAddress     String?
  notes          String?
  version        Int            @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  network      Network      @relation(fields: [networkId], references: [id], onDelete: Restrict)
  property     Property     @relation(fields: [propertyId], references: [id], onDelete: Restrict)

  connectionsFrom DeviceConnection[] @relation("sourceDevice")
  connectionsTo   DeviceConnection[] @relation("targetDevice")
  fiberRunsFrom   FiberRun[]         @relation("startDevice")
  fiberRunsTo     FiberRun[]         @relation("endDevice")
  circuits        Circuit[]

  @@index([organizationId])
  @@index([organizationId, category])
  @@index([organizationId, floor])
  @@index([organizationId, networkId])
  @@index([organizationId, propertyId])
}

model Network {
  id             String  @id @default(uuid())
  organizationId String
  userId         String?
  name           String
  homeAddress    String?
  homeLatitude   Float?
  homeLongitude  Float?
  homePublicIp   String?
  isp            String?
  downMbps       Float?
  upMbps         Float?
  version        Int     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  devices      Device[]
  networkLinks NetworkProperty[]

  @@index([organizationId])
}

model DeviceConnection {
  id             String         @id @default(uuid())
  organizationId String
  userId         String?
  sourceDeviceId String
  targetDeviceId String
  connectionType ConnectionType
  notes          String?
  version        Int            @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  sourceDevice Device       @relation("sourceDevice", fields: [sourceDeviceId], references: [id], onDelete: Cascade)
  targetDevice Device       @relation("targetDevice", fields: [targetDeviceId], references: [id], onDelete: Cascade)

  @@unique([organizationId, sourceDeviceId, targetDeviceId, connectionType])
  @@index([organizationId, sourceDeviceId])
  @@index([organizationId, targetDeviceId])
}

model FiberRun {
  id             String  @id @default(uuid())
  organizationId String
  userId         String?
  name           String
  startDeviceId  String
  endDeviceId    String
  cableType      String?
  lengthMeters   Float?
  notes          String?
  version        Int     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  startDevice  Device       @relation("startDevice", fields: [startDeviceId], references: [id], onDelete: Cascade)
  endDevice    Device       @relation("endDevice", fields: [endDeviceId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, startDeviceId])
  @@index([organizationId, endDeviceId])
}

model Circuit {
  id             String  @id @default(uuid())
  organizationId String
  userId         String?
  ispName        String
  circuitId      String?
  serviceType    String
  bandwidth      Float?
  deviceId       String?
  notes          String?
  version        Int     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  device       Device?      @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([organizationId, deviceId])
}

// ─── Metrics & Audit Models ───────────────────────────────────────────────────

model DeviceMetric {
  id                String   @default(uuid())
  organizationId    String
  userId            String
  deviceId          String?
  sourceType        String
  tag               String?
  bandwidthDown     Float?
  bandwidthUp       Float?
  latency           Float?
  connectionQuality String?
  time              DateTime @default(now())

  // No @updatedAt — metrics are immutable once written
  // No version column — metrics are append-only
  // No User/Device relation — avoids Prisma overhead on hypertable. deviceId
  // is a plain nullable column; foreign-key cascade is handled in app layer.
  // organizationId is a plain column (no FK relation) — same reason as above.
  // tag is 'ambient' (default) or 'speedtest' (on-demand). Null treated as 'ambient'.
  // Composite PK: TimescaleDB requires the partitioning column (time) to be
  // part of every unique constraint on a hypertable.

  @@id([id, time])
  @@index([organizationId, time(sort: Desc)])
  @@index([organizationId, sourceType, time(sort: Desc)])
  @@index([organizationId, deviceId, time(sort: Desc)])
}

model ChangeLog {
  id             String       @id @default(uuid())
  organizationId String
  userId         String?
  requestId      String
  action         ChangeAction
  entityType     String
  entityId       String
  field          String?
  oldValue       String?
  newValue       String?
  snapshot       Json?
  ipAddress      String?
  userAgent      String?
  comment        String?
  createdAt      DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, entityType, entityId])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([requestId])
}

// ─── Organization Tenancy Models (F1a Phase A) ───────────────────────────────

model Organization {
  id              String   @id @default(uuid())
  name            String
  namingPattern   String?
  namingMaxLen    Int?     @default(63)
  namingTemplate  String?
  version         Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  members          OrganizationMember[]
  domains          OrganizationDomain[]
  changeLogs       ChangeLog[]
  devices          Device[]
  networks         Network[]
  connections      DeviceConnection[]
  fiberRuns        FiberRun[]
  circuits         Circuit[]
  invitations      Invitation[]
  joinRequests     JoinRequest[]
  properties       Property[]
  networkProperties NetworkProperty[]
}

model OrganizationDomain {
  id             String   @id @default(uuid())
  organizationId String
  domain         String   @unique
  verified       Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model OrganizationMember {
  id             String   @id @default(uuid())
  userId         String   @unique
  organizationId String
  role           OrgRole  @default(MEMBER)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Invitation {
  id              String    @id @default(uuid())
  organizationId  String
  email           String
  role            OrgRole   @default(MEMBER)
  token           String    @unique
  expiresAt       DateTime
  invitedByUserId String?
  acceptedAt      DateTime?
  createdAt       DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
}

model JoinRequest {
  id              String            @id @default(uuid())
  organizationId  String
  userId          String
  status          JoinRequestStatus @default(PENDING)
  decidedByUserId String?
  decidedAt       DateTime?
  createdAt       DateTime          @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([userId])
}

// ─── Site Tree Models (F2) ────────────────────────────────────────────────────

model Property {
  id             String       @id @default(uuid())
  organizationId String
  parentId       String?
  type           PropertyType
  name           String
  code           String?
  version        Int          @default(1)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization  Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent        Property?         @relation("PropertyTree", fields: [parentId], references: [id], onDelete: Restrict)
  children      Property[]        @relation("PropertyTree")
  devices       Device[]
  networkLinks  NetworkProperty[]

  @@index([organizationId])
  @@index([organizationId, parentId])
  @@index([organizationId, type])
}

// ─── Network Charter Models (F2 Phase B) ─────────────────────────────────────

model NetworkProperty {
  id             String   @id @default(uuid())
  organizationId String
  networkId      String
  propertyId     String
  createdAt      DateTime @default(now())

  network      Network      @relation(fields: [networkId], references: [id], onDelete: Cascade)
  property     Property     @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([networkId, propertyId])
  @@index([organizationId])
  @@index([propertyId])
}

