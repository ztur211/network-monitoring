generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum AccountTier {
  PERSONAL_FREE
  PERSONAL_PAID
  MULTI_PROPERTY
  ENTERPRISE
}

enum DeviceCategory {
  // ISP Equipment - minZoom 10
  RAD
  ONT
  DSLAM

  // Core Infrastructure - minZoom 13
  ROUTER
  MODEM
  FIBER_MEDIA_CONVERTER
  FIREWALL

  // Network Equipment - minZoom 16
  SWITCH
  ACCESS_POINT
  WIFI_EXTENDER
  WIRELESS_BRIDGE
  SERVER_RACK
  PATCH_PANEL
  UPS

  // End-User Devices - minZoom 18
  COMPUTER
  PHONE
  TABLET
  PRINTER
  IOT_DEVICE

  // Browser-as-device (always visible, minZoom 0) - the user's current session device
  BROWSER_CLIENT

  // Other - minZoom 16
  CUSTOM
}

enum DeviceMobility {
  HOME_ONLY
  ROAMS
  UNKNOWN
}

enum ConnectionType {
  ETHERNET
  FIBER
  WIFI
  LOGICAL
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

// ─── Better Auth Models ───────────────────────────────────────────────────────

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  emailVerified Boolean  @default(false)
  name          String?
  image         String?

  tier          AccountTier @default(PERSONAL_FREE)
  homeLatitude  Float?
  homeLongitude Float?
  mapPreferences Json    @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts   Account[]
  sessions   Session[]
  devices    Device[]
  circuits   Circuit[]
  fiberRuns  FiberRun[]
  connections DeviceConnection[]
  changeLogs ChangeLog[]
  networks   Network[]

  // orgMember OrganizationMember?  // Post-MVP: uncomment when OrganizationMember model is activated
}

model Account {
  id                    String    @id @default(uuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([identifier])
}

// ─── Device & Network Models ──────────────────────────────────────────────────

model Device {
  id              String         @id @default(uuid())
  userId          String
  networkId       String?
  name            String
  category        DeviceCategory
  mobility        DeviceMobility @default(UNKNOWN)
  browserDeviceId String?
  latitude        Float?
  longitude       Float?
  floor           Int?
  floorLabel      String?
  ipAddress       String?
  macAddress      String?
  notes           String?
  version         Int            @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  network Network? @relation(fields: [networkId], references: [id], onDelete: SetNull)

  connectionsFrom DeviceConnection[] @relation("sourceDevice")
  connectionsTo   DeviceConnection[] @relation("targetDevice")
  fiberRunsFrom   FiberRun[]         @relation("startDevice")
  fiberRunsTo     FiberRun[]         @relation("endDevice")
  circuits        Circuit[]

  @@unique([userId, name])
  @@unique([userId, browserDeviceId])
  @@index([userId])
  @@index([userId, category])
  @@index([userId, floor])
  @@index([userId, networkId])
}

model Network {
  id            String  @id @default(uuid())
  userId        String
  // RESERVED — null in MVP. FK target for the future Property model in the
  // Multi-Property tier (post-MVP Priority 2). The Property → Network → Device
  // hierarchy is the structural anchor of that tier: a Property has many
  // Networks; a Network belongs to at most one Property. Services do not read
  // or write this column in MVP. Device.propertyId and DeviceMetric.propertyId
  // are NOT reserved — they reach Property via Device → Network → Property.
  propertyId    String?
  name          String
  homeAddress   String?
  homeLatitude  Float?
  homeLongitude Float?
  homePublicIp  String?
  isp           String?
  downMbps      Float?
  upMbps        Float?
  version       Int     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  devices Device[]

  @@index([userId])
  @@index([userId, propertyId])
}

model DeviceConnection {
  id             String         @id @default(uuid())
  userId         String
  sourceDeviceId String
  targetDeviceId String
  connectionType ConnectionType
  notes          String?
  version        Int            @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceDevice Device @relation("sourceDevice", fields: [sourceDeviceId], references: [id], onDelete: Cascade)
  targetDevice Device @relation("targetDevice", fields: [targetDeviceId], references: [id], onDelete: Cascade)

  @@unique([userId, sourceDeviceId, targetDeviceId, connectionType])
  @@index([userId, sourceDeviceId])
  @@index([userId, targetDeviceId])
}

model FiberRun {
  id            String  @id @default(uuid())
  userId        String
  name          String
  startDeviceId String
  endDeviceId   String
  cableType     String?
  lengthMeters  Float?
  notes         String?
  version       Int     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  startDevice Device @relation("startDevice", fields: [startDeviceId], references: [id], onDelete: Cascade)
  endDevice   Device @relation("endDevice", fields: [endDeviceId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, startDeviceId])
  @@index([userId, endDeviceId])
}

model Circuit {
  id          String  @id @default(uuid())
  userId      String
  ispName     String
  circuitId   String?
  serviceType String
  bandwidth   Float?
  deviceId    String?
  notes       String?
  version     Int     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, deviceId])
}

// ─── Metrics & Audit Models ───────────────────────────────────────────────────

model DeviceMetric {
  id                String  @default(uuid())
  userId            String
  deviceId          String?
  sourceType        String
  tag               String?
  bandwidthDown     Float?
  bandwidthUp       Float?
  latency           Float?
  connectionQuality String?
  time              DateTime @default(now())

  // No @updatedAt — metrics are immutable once written
  // No version column — metrics are append-only
  // No User/Device relation — avoids Prisma overhead on hypertable. deviceId
  // is a plain nullable column; foreign-key cascade is handled in app layer.
  // tag is 'ambient' (default) or 'speedtest' (on-demand). Null treated as 'ambient'.
  // Composite PK: TimescaleDB requires the partitioning column (time) to be
  // part of every unique constraint on a hypertable.

  @@id([id, time])
  @@index([userId, time(sort: Desc)])
  @@index([userId, sourceType, time(sort: Desc)])
  @@index([userId, deviceId, time(sort: Desc)])
}

model ChangeLog {
  id         String  @id @default(uuid())
  userId     String
  entityType String
  entityId   String
  field      String
  oldValue   String?
  newValue   String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, entityType, entityId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([entityId])
}

