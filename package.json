{
  "name": "nodescope",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:desktop": "npm run dev --workspace=apps/desktop",
    "test": "npm run test --workspaces --if-present",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "load-large-sample-model": "node scripts/load-large-sample-model.mjs",
    "postinstall": "patch-package && npm run build --workspace=packages/shared && npm run build --workspace=packages/client"
  },
  "engines": {
    "node": ">=20.0.0 <23.0.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "expo-router": "55.0.14",
    "patch-package": "^8.0.1",
    "react-native": "0.85.3",
    "react-native-worklets": "0.8.3"
  }
}
