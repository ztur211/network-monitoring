{
  "name": "nodescope",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:desktop": "npm run dev --workspace=apps/desktop",
    "test": "npm run test --workspaces --if-present",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "load-large-sample-model": "node scripts/load-large-sample-model.mjs",
    "postinstall": "npm run build --workspace=packages/shared && npm run build --workspace=packages/client"
  },
  "engines": {
    "node": ">=22.13.0 <23.0.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "vite": "^7.3.6"
  }
}
