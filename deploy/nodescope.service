[Unit]
Description=NodeScope appliance (docker compose stack)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=__DEPLOY_DIR__
ExecStart=docker compose -f __DEPLOY_DIR__/docker-compose.prod.yml --env-file __DEPLOY_DIR__/.env up -d
ExecStop=docker compose -f __DEPLOY_DIR__/docker-compose.prod.yml --env-file __DEPLOY_DIR__/.env down

[Install]
WantedBy=multi-user.target
