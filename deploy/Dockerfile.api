# syntax=docker/dockerfile:1
#
# NodeScope API (NestJS) — multi-stage build for the self-hosted demo.
# Build context is the repo ROOT (deploy/docker-compose.prod.yml sets context: ..).
#
#   build stage : `npm ci` runs the root postinstall (patch-package, prisma
#                 generate, build @nodescope/shared), then `nest build` -> dist.
#   runtime     : runs `prisma migrate deploy`, then `node apps/api/dist/main.js`.
#
# Both stages share one base image so argon2's native binding and the Prisma
# query engine stay ABI-compatible between build and runtime.

FROM node:20-bookworm-slim AS build
WORKDIR /app
# Toolchain for native-module source fallback (argon2 ships prebuilds, but keep
# the compile path working) + openssl/ca-certs for the Prisma engine download.
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 make g++ openssl ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# 1) Install with the full workspace manifest set so npm workspaces links all
#    packages and the root postinstall can run. postinstall needs the prisma
#    schema, the package sources it builds (shared/client/probe — their
#    tsconfigs extend the root tsconfig.base.json), and patches/ — copy those
#    first so the dependency layer caches across source-only changes.
COPY package.json package-lock.json .npmrc tsconfig.base.json ./
COPY patches ./patches
COPY packages/shared ./packages/shared
COPY packages/client ./packages/client
COPY packages/probe ./packages/probe
COPY apps/api/package.json ./apps/api/
COPY apps/api/prisma ./apps/api/prisma
COPY apps/web/package.json ./apps/web/
RUN npm ci --legacy-peer-deps

# 2) Build the API. @nodescope/shared was already built by the postinstall above.
COPY apps/api ./apps/api
# scripts/ carries load-sample-model.mjs so the demo-seed one-shot service (see
# docker-compose.demo.yml) can populate the FZK-Haus model on first boot.
COPY scripts ./scripts
RUN npm run build --workspace=apps/api

# ---------------------------------------------------------------------------
FROM node:20-bookworm-slim AS runtime
ENV NODE_ENV=production
WORKDIR /app
RUN apt-get update \
 && apt-get install -y --no-install-recommends openssl ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# Bring the whole built workspace: node_modules carries the Prisma CLI + the
# generated client, and the @nodescope/shared workspace symlink resolves to the
# copied packages/shared (with its built dist).
COPY --from=build /app /app
# Runtime product-knowledge the AI ProductContext reads from
# `process.cwd()/docs/product-knowledge` (cwd is /app at runtime).
COPY docs/product-knowledge ./docs/product-knowledge
COPY deploy/api-entrypoint.sh /usr/local/bin/api-entrypoint.sh
RUN chmod +x /usr/local/bin/api-entrypoint.sh && chown -R node:node /app
# FS storage mode writes blobs here; pre-create it owned by node so a mounted
# volume at this path is writable by the (non-root) runtime user.
RUN mkdir -p /data/storage && chown -R node:node /data/storage
USER node

ENV PORT=3000
EXPOSE 3000
# Node 20 has global fetch — no curl needed in the image.
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=5 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3000)+'/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
ENTRYPOINT ["api-entrypoint.sh"]
