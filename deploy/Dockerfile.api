# syntax=docker/dockerfile:1
#
# NodeScope API (ASP.NET Core) - multi-stage build for the self-hosted appliance.
# Build context is the repo ROOT (deploy/docker-compose.build.yml sets context: ..).
#
#   build stage : dotnet publish src/NodeScope.Api (Release, warnings-as-errors)
#   runtime     : aspnet runtime image; the host applies EF migrations itself on
#                 boot (baselining a Prisma-era database), so there is no
#                 entrypoint script and no migration CLI in the image.
#
# The same image also runs the demo seed as a one-shot:
#   docker run ... nodescope-api seed        (see deploy/docker-compose.demo.yml)

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /source
# The full analyzer configuration is part of the build (EnforceCodeStyleInBuild),
# so the image build fails on exactly what a dev build fails on.
COPY Directory.Build.props Directory.Packages.props .editorconfig ./
COPY src ./src
RUN dotnet publish src/NodeScope.Api -c Release -o /app \
 && dotnet publish src/NodeScope.Backup -c Release -o /backup

# ---------------------------------------------------------------------------
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
# iputils-ping is REQUIRED, not optional: the embedded prober's ICMP
# (System.Net.NetworkInformation.Ping) falls back to spawning `ping` when
# unprivileged ICMP sockets are unavailable, and without a ping binary every
# ICMP-only device reads DOWN - a broken image masquerading as a fleet-wide
# outage (the node:*-slim lesson, deliberately carried over).
# curl backs the image/compose healthchecks. tar is used by the appliance's
# streamed blob backup and restore path.
RUN apt-get update \
 && apt-get install -y --no-install-recommends iputils-ping curl tar \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=build /app .
COPY --from=build /backup /opt/nodescope-backup
# FS storage mode (the appliance default) writes blobs here; pre-create it owned
# by the image's non-root `app` user so a mounted volume at this path is writable.
RUN mkdir -p /data/storage && chown -R app:app /data/storage
USER app

ENV ASPNETCORE_HTTP_PORTS=3000
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=5 \
  CMD curl -fsS http://127.0.0.1:3000/api/health || exit 1
ENTRYPOINT ["dotnet", "NodeScope.Api.dll"]
