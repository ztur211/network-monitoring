{
	# TLS is terminated upstream by Cloudflare Tunnel in the recommended demo
	# setup, so Caddy serves plain HTTP on :80. To let Caddy obtain its own
	# Let's Encrypt certificate instead, set SITE_ADDRESS to your domain,
	# publish 443, and delete this `auto_https off`.
	auto_https off
}

# SITE_ADDRESS defaults to ":80" (listen on 80, any host). API_UPSTREAM defaults
# to the compose service name "api:3000".
{$SITE_ADDRESS::80} {
	encode zstd gzip

	# API + realtime → the ASP.NET Core service (same origin as the web app).
	# reverse_proxy transparently handles the SignalR WebSocket upgrade.
	handle /api/* {
		reverse_proxy {$API_UPSTREAM:api:3000}
	}
	handle /hubs/* {
		reverse_proxy {$API_UPSTREAM:api:3000}
	}

	# Map tiles (Decision 15): server-rasterized liberty tiles from tileserver-gl,
	# so the desktop map needs zero WAN at runtime. handle_path strips the /tiles
	# prefix - the client fetches /tiles/styles/liberty/{z}/{x}/{y}.png and the
	# tileserver sees /styles/... at its root.
	handle_path /tiles/* {
		reverse_proxy {$TILES_UPSTREAM:tiles:8080}
	}

	# Agent distribution (Decision 13): binaries, manifest, and installers baked
	# into this image at /srv/agent, staged by scripts/agent-release/build.sh.
	# A dedicated handle so a missing file 404s - the agent's update check must
	# see 404, never the SPA's index.html fallback.
	handle /agent/* {
		root * /srv
		file_server
	}

	# Everything else → the API host (step 6: the SPA is gone). The host serves the
	# browser-facing auth page at /login (the desktop-auth bounce target), redirects
	# / and /register onto it, and answers everything unknown with its JSON 404 -
	# no catchall HTML exists anymore, which is also what the agent's update check
	# and the desktop's error mapping want.
	handle {
		# Security headers for the browser-facing page (the desktop client ignores
		# them; the sign-in page is the one surface a real browser renders).
		header {
			Strict-Transport-Security "max-age=31536000; includeSubDomains"
			X-Content-Type-Options "nosniff"
			X-Frame-Options "DENY"
			Referrer-Policy "strict-origin-when-cross-origin"
			# The auth page uses no sensor APIs.
			Permissions-Policy "geolocation=(), camera=(), microphone=()"
			# Hide the server banner.
			-Server
		}
		reverse_proxy {$API_UPSTREAM:api:3000}
	}
}
