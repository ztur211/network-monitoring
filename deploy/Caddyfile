{
	# TLS is terminated upstream by Cloudflare Tunnel in the recommended demo
	# setup, so Caddy serves plain HTTP on :80. To let Caddy obtain its own
	# Let's Encrypt certificate instead, set SITE_ADDRESS to your domain,
	# publish 443, and delete this `auto_https off`.
	auto_https off
}

# SITE_ADDRESS defaults to ":80" (listen on 80, any host). API_UPSTREAM defaults
# to the compose service name "api:3000".
{$SITE_ADDRESS::80} {
	encode zstd gzip

	# API + realtime → the ASP.NET Core service (same origin as the web app).
	# reverse_proxy transparently handles the SignalR WebSocket upgrade.
	handle /api/* {
		reverse_proxy {$API_UPSTREAM:api:3000}
	}
	handle /hubs/* {
		reverse_proxy {$API_UPSTREAM:api:3000}
	}

	# Agent distribution (Decision 13): binaries, manifest, and installers baked
	# into this image at /srv/agent, staged by scripts/agent-release/build.sh.
	# A dedicated handle so a missing file 404s - the agent's update check must
	# see 404, never the SPA's index.html fallback.
	handle /agent/* {
		root * /srv
		file_server
	}

	# Web SPA: serve the static export; unknown paths fall back to index.html so
	# expo-router can handle client-side routing.
	handle {
		# Security headers for the SPA responses. (The API responses get their own
		# from helmet in main.ts; scoping these to the web handle avoids duplicating
		# or conflicting with those on the proxied /api + /socket.io paths.)
		header {
			Strict-Transport-Security "max-age=31536000; includeSubDomains"
			X-Content-Type-Options "nosniff"
			X-Frame-Options "DENY"
			Referrer-Policy "strict-origin-when-cross-origin"
			# geolocation is allowed for self — MapView uses navigator.geolocation
			# for the "you are here" marker; camera/microphone are unused → denied.
			Permissions-Policy "geolocation=(self), camera=(), microphone=()"
			# Hide the server banner.
			-Server
			# Content-Security-Policy is intentionally left OFF here. A too-strict
			# CSP can blank the SPA by blocking Expo's bundle/workers, and the deploy
			# smoke test only checks that HTML is served — not that it renders — so a
			# broken CSP would pass CI and break the real demo. Enable + verify in a
			# real browser during host bring-up. Recommended policy (mirrors main.ts
			# / SAD §12.4); uncomment after browser verification:
			# Content-Security-Policy "default-src 'self'; img-src 'self' data: blob: https://tiles.openfreemap.org; connect-src 'self' https://tiles.openfreemap.org; script-src 'self'; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:; frame-ancestors 'none'"
		}
		root * /srv/web
		try_files {path} /index.html
		file_server
	}
}
