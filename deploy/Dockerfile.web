# syntax=docker/dockerfile:1
#
# NodeScope appliance gateway: Caddy routing the same-origin surface - /api + /hubs
# to the API host, /tiles to tileserver-gl, /agent from the baked agent-release
# payload, and everything else to the API host too (which 404s it - no browser
# surface exists). The image kept its historical "web" name through step 6 so
# existing compose files and pulls keep working; there has been no web app in it
# since the SPA was demolished. Build context is the repo ROOT (for deploy/ paths only).

FROM caddy:2-alpine
COPY deploy/Caddyfile /etc/caddy/Caddyfile
# Agent distribution payload (Decision 13): binaries + manifest + installers
# staged by scripts/agent-release/build.sh; served by Caddy at /agent/*.
# An unstaged (empty) directory just means the update manifest 404s - harmless.
COPY deploy/agent-dist/ /srv/agent/
EXPOSE 80
