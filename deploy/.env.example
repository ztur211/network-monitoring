# === NodeScope self-hosted demo — environment ===
# Copy to deploy/.env and fill in. deploy/.env is git-ignored.
# Generate secrets:
#   openssl rand -base64 48     # BETTER_AUTH_SECRET (min 32 chars)
#   openssl rand -base64 24     # POSTGRES_PASSWORD
#   openssl rand -base64 32     # SECRET_ENCRYPTION_KEY (must decode to 32 bytes)

# --- Public origin: the URL clients use to reach this server. On a LAN appliance
#     `deploy/nodescope.sh install` sets this automatically to
#     http://<detected-lan-ip>:<WEB_PORT>. Set it manually only for a fixed
#     hostname / HTTPS deploy. The API uses it for CORS (FRONTEND_URL) + auth;
#     the web bundle is same-origin so it is NOT baked in. ---
PUBLIC_ORIGIN=

# --- Database (internal to the compose network; no host port is published) ---
POSTGRES_USER=nodescope
POSTGRES_PASSWORD=
POSTGRES_DB=nodescope

# --- Secrets ---
BETTER_AUTH_SECRET=
SECRET_ENCRYPTION_KEY=
ANTHROPIC_API_KEY=

# --- AI / geocoding ---
AI_PROVIDER=claude
GEOCODING_USER_AGENT=NodeScope/1.0 (you@example.com)

# --- Storage: single-node appliance = local filesystem (no MinIO/S3) ---
STORAGE_DRIVER=fs

# --- Image version: the GHCR tag the appliance pulls (ghcr.io/ztur211/nodescope-*).
#     Pin a concrete release so `nodescope.sh update`/`pull` never jumps silently.
#     `nodescope.sh update <version>` bumps this; `rollback` restores the prior pin. ---
NODESCOPE_VERSION=latest

# --- Backups (nodescope.sh backup): how many timestamped bundles to keep ---
BACKUP_KEEP=7
# Where `backup` writes bundles and `rollback` looks for them (default: deploy/backups).
# BACKUP_DIR=/var/backups/nodescope

# --- Optional: encrypted off-site backup (S3-compatible). Off unless PUBKEY+BUCKET set. ---
# Generate the keypair with: ./deploy/nodescope.sh offsite-keygen
OFFSITE_BACKUP_PUBKEY=
OFFSITE_S3_ENDPOINT=
OFFSITE_S3_REGION=auto
OFFSITE_S3_BUCKET=
OFFSITE_S3_ACCESS_KEY=
OFFSITE_S3_SECRET_KEY=
OFFSITE_S3_PREFIX=nodescope
OFFSITE_KEEP=7
OFFSITE_INCLUDE_BLOBS=true

# --- Web / proxy exposure ---
# Host port the Caddy (web) container binds; your tunnel / reverse proxy targets it.
WEB_PORT=8080
# Caddy listen address. ':80' = plain HTTP behind Cloudflare Tunnel (default).
# Set to your domain to have Caddy fetch its own TLS cert (then publish 443 and
# remove `auto_https off` from deploy/Caddyfile).
SITE_ADDRESS=:80
# Proxy hops in front of the API to trust for the real client IP (per-IP AI rate
# limiting + the away-from-home check). 1 = one Caddy hop (default); behind
# Cloudflare Tunnel → Caddy → API set 2. Also accepts true/false or an IP/subnet.
TRUST_PROXY=1

# --- Optional: Cloudflare Tunnel (run with `--profile tunnel`) ---
# Create a tunnel in the Cloudflare dashboard, route your hostname to
# http://web:80, and paste its token here.
CLOUDFLARE_TUNNEL_TOKEN=

# --- Optional: demo seed user (only used if you run `prisma db seed`) ---
SEED_PASSWORD=
