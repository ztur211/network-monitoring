# === NodeScope self-hosted demo - environment ===
# Copy to deploy/.env and fill in. deploy/.env is git-ignored.
# Generate secrets:
#   openssl rand -base64 48     # BETTER_AUTH_SECRET (min 32 chars)
#   openssl rand -base64 24     # POSTGRES_PASSWORD
#   openssl rand -base64 32     # SECRET_ENCRYPTION_KEY (must decode to 32 bytes)

# --- Public origin: the URL clients use to reach this server. On a LAN appliance
#     `deploy/nodescope.sh install` sets this automatically to
#     http://<detected-lan-ip>:<WEB_PORT>. Set it manually only for a fixed
#     hostname / HTTPS deploy. The API uses it for CORS (FRONTEND_URL) + auth;
#     the web bundle is same-origin so it is NOT baked in. ---
PUBLIC_ORIGIN=

# --- Database (internal to the compose network; no host port is published) ---
POSTGRES_USER=nodescope
POSTGRES_PASSWORD=
POSTGRES_DB=nodescope

# --- Secrets ---
BETTER_AUTH_SECRET=
# SNMP credential encryption — the API refuses to boot without a base64 32-byte key.
SECRET_ENCRYPTION_KEY=
ANTHROPIC_API_KEY=

# --- Optional: Redis (multi-replica only; run with `--profile redis`) ---
# Empty = single-node in-memory backing (the default appliance mode).
REDIS_URL=
CLUSTER_MODE=false

# --- AI / geocoding ---
AI_PROVIDER=claude
GEOCODING_USER_AGENT=NodeScope/1.0 (you@example.com)

# --- Storage: single-node appliance = local filesystem (no MinIO/S3) ---
# fs (default): blobs on the api container's blobstore volume — nothing to configure.
# To use S3/MinIO instead, set s3 here and add the STORAGE_ENDPOINT/REGION/BUCKET/
# ACCESS_KEY/SECRET_KEY env to the api service in docker-compose.prod.yml.
STORAGE_DRIVER=fs

# --- Image version: the GHCR tag the appliance pulls (ghcr.io/ztur211/nodescope-*).
#     `latest` = newest published build; pin to a release (e.g. 0.1.0) in production. ---
NODESCOPE_VERSION=latest

# --- Web / proxy exposure ---
# Host port the Caddy (web) container binds; your tunnel / reverse proxy targets it.
WEB_PORT=8080
# Caddy listen address. ':80' = plain HTTP behind Cloudflare Tunnel (default).
# Set to your domain to have Caddy fetch its own TLS cert (then publish 443 and
# remove `auto_https off` from deploy/Caddyfile).
SITE_ADDRESS=:80
# Proxy hops in front of the API to trust for the real client IP (per-IP AI rate
# limiting + the away-from-home check). 1 = one Caddy hop (default); behind
# Cloudflare Tunnel → Caddy → API set 2. Also accepts true/false or an IP/subnet.
TRUST_PROXY=1

# --- Optional: Cloudflare Tunnel (run with `--profile tunnel`) ---
# Create a tunnel in the Cloudflare dashboard, route your hostname to
# http://web:80, and paste its token here.
CLOUDFLARE_TUNNEL_TOKEN=

# --- Container resource limits ---
# Every service is capped so a runaway one degrades itself instead of taking the host
# down with it. Defaults target a modest 4GB / 2-core appliance host (~2.2GB total);
# raise them on a bigger box. Exceeding the memory limit gets the container OOM-killed
# and restarted - loud and recoverable, which is the intent.
DB_MEMORY_LIMIT=1g
DB_CPU_LIMIT=1.0
API_MEMORY_LIMIT=1g
API_CPU_LIMIT=1.0
# Keep V8's heap ceiling below API_MEMORY_LIMIT (~75%) so runaway growth throws a
# catchable heap error inside Node rather than an unexplained OOM kill of the container.
API_NODE_OPTIONS=--max-old-space-size=768
WEB_MEMORY_LIMIT=192m
WEB_CPU_LIMIT=0.5
# Only used with `--profile redis`. maxmemory sits under the container limit so Redis
# evicts (allkeys-lru) instead of being OOM-killed.
REDIS_MEMORY_LIMIT=256m
REDIS_CPU_LIMIT=0.5
REDIS_MAXMEMORY=192mb
TUNNEL_MEMORY_LIMIT=128m
TUNNEL_CPU_LIMIT=0.5

# --- Optional: embedded prober (on-network monitoring without the Agent) ---
# OFF by default; the managed cloud cannot reach a LAN and uses the Agent instead.
# Turn it on ONLY for a self-hosted appliance that sits on the network it monitors.
#
# SIZE THE INTERVAL TO THE FLEET. A cycle's wall-time is roughly
#   (devices / MONITORING_PROBE_CONCURRENCY) x MONITORING_PROBE_TIMEOUT_MS
# and an UNREACHABLE device costs the full timeout. If a cycle cannot finish within
# MONITORING_PROBE_INTERVAL_MS the prober logs a warning and SKIPS the tick - it will
# not stack cycles - but you are then probing slower than you configured. Raise the
# interval (or the concurrency) until the warning stops.
MONITORING_PROBER_ENABLED=false
MONITORING_PROBE_INTERVAL_MS=30000
MONITORING_PROBE_CONCURRENCY=20
MONITORING_PROBE_TIMEOUT_MS=2000
MONITORING_PROBE_PORTS=443,80,22

# --- Optional: demo seed user (only used if you run `prisma db seed`) ---
SEED_PASSWORD=
