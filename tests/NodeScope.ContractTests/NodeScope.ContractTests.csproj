<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The permanent black-box integration suite. It talks to a BASE_URL over HTTP
    and SignalR and references NO implementation project by design.

    The absence of a ProjectReference here is load-bearing, not an oversight.
    Contracts is referenced only for DTO shapes; if that ever tempts anyone
    toward referencing a module, the suite has stopped being black-box.
  -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />

    <!--
      Npgsql backs the ONE non-HTTP step the suite is allowed (the super-admin
      grant in Fixtures/SuperAdminGrant.cs). It is not a step toward talking to the
      database in general - every other arrange path goes over HTTP.
    -->
    <PackageReference Include="Npgsql" />

    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/NodeScope.Contracts/NodeScope.Contracts.csproj" />
  </ItemGroup>

</Project>
