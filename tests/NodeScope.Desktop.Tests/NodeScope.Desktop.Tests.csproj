<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Decision 18: Avalonia.Headless drives real windows without a display, so the
    client's view tests run in WSL2 today and on whatever CI runner lands later.
    The app under test is the REAL App (theme, XAML, compiled bindings) - only
    the platform is swapped, by TestAppBuilder.
  -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- xunit v3 test projects are executables (required by Avalonia.Headless.XUnit 12). -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Avalonia.Headless.XUnit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/NodeScope.Desktop/NodeScope.Desktop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Fixtures/wall.ifc" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures/georeferenced-site.ifc" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
