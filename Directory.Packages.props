<Project>

  <!--
    Central Package Management: every NuGet version for the whole solution is
    declared here exactly once, and .csproj files carry bare <PackageReference
    Include="..." /> with no Version attribute.

    This exists because dependency sprawl is motivation #2 of the migration
    (docs/migration/csharp-migration-decisions.md). The TypeScript monorepo
    reached `legacy-peer-deps=true` and patch-package partly because versions
    were scattered across seven package.json files and drifted against each
    other. One file makes that drift impossible rather than merely visible.

    Versions are deliberately left off until the packages are actually needed -
    an empty list is the honest starting state, and each entry gets pinned when
    the module that needs it lands.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Test stack (Decision 18: xUnit + Testcontainers).

      NetArchTest was pinned here and then removed: the architecture rules ended
      up expressible with plain reflection over assembly references, so the
      dependency bought nothing. Reconsider it if a rule is ever needed at
      namespace granularity *within* an assembly, which reflection handles
      poorly. Testcontainers gets pinned when the first module-level integration
      test lands.
    -->
    <!--
      SNMP for the agent (Decision 12, resolved 2026-07-21). Verified under
      NativeAOT + full trimming against net-snmp 5.9.4: v2c GET/BulkWalk and v3
      authPriv (SHA-256/AES) all pass from an AOT binary with the assembly
      rooted via TrimmerRootAssembly. Known gap: no SHA-224 auth provider.
    -->
    <PackageVersion Include="Lextm.SharpSnmpLib" Version="12.5.7" />

    <!--
      API port (sequencing step 4). EF Core + Npgsql per Decision 5; the Npgsql
      provider's own train (10.0.3) lags the EF core packages (10.0.10) - both
      are the latest stable of their line. (YARP, which backed the Decision 21
      transition proxy, was deleted at the Decision 11 cutover.)
    -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.10" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!--
      Decision 11/20: the migrations-only model (NodeScope.Migrations) owns the schema.
      Design is the dotnet-ef tooling hook; the NetTopologySuite plugin exists solely so
      the PostGIS geometry(Point,4326) column scaffolds and emits correct DDL - runtime
      spatial access stays raw SQL and no module references NTS.
    -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL.NetTopologySuite" Version="10.0.3" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.10" />

    <!--
      Object storage (Decision 10): S3-compatible blobs for IFC building models and BCF
      archives, MinIO on the appliance. The AWS SDK is the only maintained S3 client for
      .NET; AWSSDK.S3 pulls in AWSSDK.Core alone.
    -->
    <PackageVersion Include="AWSSDK.S3" Version="4.0.101.4" />
    <!-- Pinned explicitly: the version AWSSDK.S3 resolves transitively carries GHSA-9cvc-h2w8-phrp. -->
    <PackageVersion Include="AWSSDK.Core" Version="4.0.100.8" />

    <!--
      Argon2id for native credential hashing. Account.password values migrated from
      the retired service verify unchanged (m=65536 t=3 p=4 len=32 v=19, PHC-encoded). Managed
      implementation - no native binding to trip NativeAOT or the container build.
    -->
    <PackageVersion Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />

    <!--
      Desktop client (step 5, Decision 14: Avalonia 12). Fonts.Inter bundles the
      UI font so text renders identically on every OS instead of falling back to
      whatever the host has installed. Headless.XUnit is the Decision 18 test
      driver; it pulls Avalonia.Headless transitively.
    -->
    <PackageVersion Include="Avalonia" Version="12.1.0" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.0" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.0" />
    <PackageVersion Include="Avalonia.Headless.XUnit" Version="12.1.0" />

    <!--
      Map stack for the desktop client (Decision 15): Mapsui composites the
      appliance-rasterized liberty tiles with native overlay layers.
      Mapsui.Avalonia targets Avalonia 12 and pulls Mapsui/Tiling/Rendering.Skia
      + BruTile. TRAP from the spike: on Linux the SkiaSharp/HarfBuzzSharp
      NATIVE assets must be pinned to the exact managed versions in the graph -
      unpinned they resolve to mismatched natives that fail at runtime. The
      managed SkiaSharp here is 3.119.4 (Avalonia 12.1 lifts it above Mapsui's
      3.119.2), so the Linux natives pin follows the RESOLVED graph, not
      Mapsui's floor. Re-check `dotnet list package` with the transitive flag
      whenever Avalonia or Mapsui move.
    -->
    <PackageVersion Include="Mapsui.Avalonia" Version="5.1.0" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux" Version="3.119.4" />
    <PackageVersion Include="HarfBuzzSharp.NativeAssets.Linux" Version="8.3.1.3" />

    <!--
      Native BIM viewport (Decision 16): Avalonia owns the cross-platform GL
      context and Silk.NET supplies the current OpenGL bindings against that
      context. Only the binding package is needed - windowing stays Avalonia's
      responsibility.
    -->
    <PackageVersion Include="Silk.NET.OpenGL" Version="2.23.0" />
    <!--
      Decision 16 upload tessellation. Geometry's Open Cascade engine ships
      Windows native assets only, while Essentials and the wexBIM output remain
      managed. Keep the prerelease geometry build exact until xBIM publishes a
      stable netcore engine.
    -->
    <PackageVersion Include="Xbim.Essentials" Version="6.1.605" />
    <PackageVersion Include="Xbim.Geometry" Version="6.3.891-netcore" />

    <!--
      MVVM source generators for the desktop client. Used in attribute mode
      ([INotifyPropertyChanged] on partial classes), NOT by inheriting
      ObservableObject - Decision 6 reserves inheritance for framework
      integration, and the generator can embed the INPC implementation instead.
    -->
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />

    <!--
      DI + logging for the desktop client (Decision 19: first-party MEL; Serilog
      rejected). The API host gets these transitively from ASP.NET Core; the
      desktop client references them directly.
    -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.10" />

    <!--
      DPAPI for the desktop token vault (Decision 17: OS-keychain behind an
      interface, DPAPI first). Windows-only at runtime; the Linux dev vault is a
      0600 plain file until a libsecret implementation is warranted.
    -->
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.10" />

    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <!--
      Avalonia.Headless.XUnit 12.x integrates with xunit v3 (not v2), so the
      desktop test project rides the v3 line while the older projects stay on
      2.9.3; the 3.x visualstudio runner drives both generations.
    -->
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.0" />

    <!--
      The contract suite's single, deliberate non-HTTP dependency: it runs one
      `UPDATE "User" SET "isSuperAdmin" = true` to bootstrap a super-admin, because
      that flag is intentionally settable only in the database.
      Everything else the suite does is black-box HTTP. See
      tests/NodeScope.ContractTests/Fixtures/SuperAdminGrant.cs.
    -->
    <PackageVersion Include="Npgsql" Version="10.0.3" />

    <!--
      The contract suite drives the appliance's realtime surface over its public
      SignalR wire without referencing server implementation projects.
    -->
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.0" />
  </ItemGroup>

</Project>
